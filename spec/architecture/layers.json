{
  "schemaVersion": 1,
  "layers": {
    "presentation": ["src/"],
    "application": ["js/application/"],
    "domain": ["js/domain/"],
    "repositoryContracts": ["js/core/"],
    "infrastructure": ["js/services/", "js/pwa/"],
    "localDatabase": ["js/core/"],
    "futureIntegrations": []
  },
  "allowedImports": {
    "presentation": ["application", "domain", "repositoryContracts", "infrastructure"],
    "application": ["domain", "repositoryContracts", "infrastructure"],
    "domain": [],
    "repositoryContracts": ["localDatabase"],
    "infrastructure": ["repositoryContracts", "localDatabase", "futureIntegrations"],
    "localDatabase": [],
