{
  "schemaVersion": 1,
  "modules": {
    "Vehicle": "vehicle",
    "Driver": "driver",
    "Work": "work",
    "Fuel": "fuel",
    "Expenses": "expenses",
    "Revenue": "revenue",
    "Loans": "loans",
    "Maintenance": "maintenance",
    "Compliance": "renewals",
    "Dashboard": "dashboard",
    "Profitability": "profitability",
    "Historical Entries": "historical",
    "Settings": "settings"
  },
  "currentScope": {
    "Vehicle": {"required": true},
    "Driver": {"required": false, "scope": "future", "analytics": false},
    "Work": {"required": true},
    "Fuel": {"required": true},
    "Expenses": {"required": true},
    "Revenue": {"required": true},
    "Loans": {"required": true},
    "Maintenance": {"required": true},
    "Compliance": {"required": true},
    "Dashboard": {"required": true},
    "Profitability": {"required": true},
    "Historical Entries": {"required": true},
    "Settings": {"required": true, "surface": "admin-child", "parent": "Admin"}
  },
  "presentationRules": [
    "Business calculations belong outside Vue presentation components.",
    "Loan calculations belong in the domain/application layers, not loan presentation.",
    "Future-scope modules must not be treated as required current-scope UI capabilities.",
    "Historical Entries must expose its save-request contract.",
    "Required admin-child modules must be represented under their declared Admin parent and are not primary driver navigation destinations."
  ]
}
